@page
@model restaurantBudweis.Pages.GroupDishs.IndexModel
@{
    ViewData["Title"] = "Список групп блюд";
}

<div class="container mt-4">
    <div class="row justify-content-between align-items-center mb-4">
        <div class="col">
            <h1 class="h3 mb-0">Список групп блюд</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary">Добавить группу</a>
        </div>
    </div>

    <div class="row">
        @foreach (var group in Model.GroupDishs)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@group.Dishs</h5>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted">ID: @group.Id</small>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Edit" asp-route-id="@group.Id" class="btn btn-outline-secondary">Изменить</a>
                                <a asp-page="Delete" asp-route-id="@group.Id" class="btn btn-outline-danger">Удалить</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.GroupDishs.Any())
    {
        <div class="alert alert-info text-center">
            Список групп блюд пуст. Добавьте первую группу!
        </div>
    }
</div>