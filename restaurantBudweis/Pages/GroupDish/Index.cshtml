@page
@model restaurantBudweis.Pages.GroupDishs.IndexModel
@{
    ViewData["Title"] = "Список групп блюд";
}

<div class="container mt-4">
    <div class="row justify-content-between align-items-center mb-4">
        <div class="col">
            <h1 class="h3 mb-0">Список групп блюд</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary rounded-pill px-4">
                + Добавить группу
            </a>
        </div>
    </div>

    <div class="row">
        @foreach (var group in Model.GroupDishs)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@group.Name</h5>
                        @if (!string.IsNullOrEmpty(group.Dishs))
                        {
                            <p class="card-text text-muted small">@group.Dishs</p>
                        }
                        else
                        {
                            <p class="card-text text-muted fst-italic small">Нет описания</p>
                        }
                        <hr />
                    </div>
                    <div class="card-footer d-flex justify-content-between rounded-bottom-4 bg-body-secondary">
                        <small class="text-muted align-self-center">ID: @group.Id</small>
                        <div class="btn-group gap-2">
                            <a asp-page="Details" asp-route-id="@group.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Открыть</a>
                            <a asp-page="Edit" asp-route-id="@group.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">Изменить</a>
                            <a asp-page="Delete" asp-route-id="@group.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.GroupDishs.Any())
    {
        <div class="alert alert-info text-center rounded-4">
            Список групп блюд пуст. Добавьте первую группу!
        </div>
    }
</div>