@page
@model restaurantBudweis.Pages.Chat.SupportChatModel
@{
    ViewData["Title"] = "Чат поддержки";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm rounded-4 border-0 overflow-hidden">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 h5">💬 Чат техподдержки Budweis</h4>
                </div>

                <div class="card-body bg-body-tertiary" id="chatBounds" style="height: 450px; overflow-y: auto;">
                    <div id="chatWindow" class="d-flex flex-column gap-3">
                    </div>
                </div>

                <div class="card-footer bg-transparent p-3 border-top-0">
                    <div class="input-group">
                        <input type="text" id="msgField" class="form-control rounded-start-pill px-3" placeholder="Напишите сообщение..." autocomplete="off" />
                        <button class="btn btn-primary rounded-end-pill px-4" id="sendBtn">Отправить</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        // 2. Настраиваем подключение к нашему адресу хаба, который мы регистрировали в Program.cs
        const chatConn = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect() // Авто-переподключение, если пропадет интернет
            .build();

        // 3. Вытаскиваем роль текущего пользователя из C# в JavaScript переменную
        const myRole = "@(User.FindFirst(System.Security.Claims.ClaimsIdentity.DefaultRoleClaimType)?.Value ?? "User")";

        // 4. Слушаем сервер. Когда сервер пришлет событие "ReceiveMessage", сработает эта функция
        chatConn.on("ReceiveMessage", function (msg) {
            const windowNode = document.getElementById("chatWindow");
            const outerDiv = document.createElement("div");

            // Задаем базовые стили карточки сообщения
            outerDiv.className = "p-3 rounded-4 shadow-sm border border-opacity-25";

            // Если пишет Админ — красим в золотистый цвет и прижимаем влево.
            // Если Пользователь — красим в синий и прижимаем вправо.
            if (msg.role === "Admin") {
                outerDiv.className += " border-warning bg-warning bg-opacity-10 align-self-start w-75";
            } else {
                outerDiv.className += " border-primary bg-primary bg-opacity-10 align-self-end w-75";
            }

            // ВЫПОЛНЕНИЕ УСЛОВИЯ НА ОЦЕНКУ «5»:
            // Если чат просматривает Администратор (myRole === "Admin"), выводим полную информацию о пользователе.
            let userHeader = "";
            if (myRole === "Admin") {
                userHeader = `
                    <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                        <img src="${msg.avatarUrl}" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
                        <span class="small fw-bold text-primary text-truncate" style="max-width: 180px;">${msg.email}</span>
                        <span class="badge rounded-pill ${msg.role === 'Admin' ? 'bg-danger' : 'bg-secondary'} small" style="font-size: 0.65rem;">${msg.role}</span>
                    </div>`;
            } else {
                // Если смотрит обычный пользователь — скрываем чужие данные ради приватности и красоты
                userHeader = `<div class="small fw-bold text-muted mb-1" style="font-size: 0.75rem;">${msg.role === 'Admin' ? '👑 Администратор' : '👤 Вы'}</div>`;
            }

            // Форматируем время отправки сообщения (Часы:Минуты)
            const timeStr = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            // Собираем всё в итоговый HTML-блок сообщения
            outerDiv.innerHTML = `
                ${userHeader}
                <div class="text-break small">${msg.text}</div>
                <div class="text-end text-muted mt-1" style="font-size: 0.65rem;">${timeStr}</div>
            `;

            // Добавляем созданный блок в окно чата
            windowNode.appendChild(outerDiv);

            // Автоматически прокручиваем скролл вниз, чтобы видеть новые сообщения
            const bounds = document.getElementById("chatBounds");
            bounds.scrollTop = bounds.scrollHeight;
        });

        // 5. Функция отправки сообщения на сервер
        function pushMessage() {
            const input = document.getElementById("msgField");
            const text = input.value.trim();
            if (!text) return; // Если текст пустой — ничего не делаем

            // Вызываем метод "SendMessage" на сервере в нашем ChatHub.cs
            chatConn.invoke("SendMessage", text).catch(err => console.error(err.toString()));

            // Очищаем поле ввода
            input.value = "";
        }

        // Навешиваем клик на кнопку отправки
        document.getElementById("sendBtn").addEventListener("click", pushMessage);

        // Позволяем отправлять сообщение по нажатию на клавишу Enter
        document.getElementById("msgField").addEventListener("keypress", e => {
            if (e.key === 'Enter') pushMessage();
        });

        // 6. Запускаем постоянное соединение с хабом
        chatConn.start().catch(err => console.error(err.toString()));
    </script>
}
