<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        @ViewData["Title"] - Ресторан "Budweis"
    </title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/restaurantBudweis.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Ресторан "Budweis"</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Dishs/Index">🍔 Блюда</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Clients/Index">👥 Клиенты</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/GroupDish/Index">📂 Группы блюд</a>
                        </li>

                        @* Показываем ссылку на чат только авторизованным пользователям *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Chat/SupportChat">💬 Чат поддержки</a>
                            </li>
                        }

                        @*можно скрыть кнопку "Пользователи", нужно поставить @ перед if и убрать комит*@
                        @*if (User.IsInRole("Admin"))*@
                        @*{*@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Account/User/Index">🛠️ Пользователи</a>
                        </li>
                        @* }*@
                    </ul>
                  
                    <ul class="navbar-nav ms-auto d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center gap-2">
                                <a asp-page="/Account/Profile" title="Редактировать профиль">
                                    <img src="@(User.FindFirst("AvatarUrl")?.Value ?? "/avatars/default.png")"
                                         alt="Avatar"
                                         class="rounded-circle border"
                                         style="width:32px; height:32px; object-fit:cover;" />
                                </a>
                                <span class="text-dark fw-bold me-2">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-danger" asp-page="/Account/Logout">Выход</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Account/Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary" asp-page="/Account/Register">Регистрация</a>
                            </li>
                        }

                        <li class="nav-item">
                            <button class="btn btn-sm btn-outline-secondary" onclick="toggleTheme()">🌓</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RestaurantBudweis - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script>
    function applyTheme(theme) {
        document.documentElement.setAttribute("data-bs-theme", theme);
        localStorage.setItem("theme", theme);
    }

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", e => {
        // Исправлена ошибка: заменено неопределенное 'html' на 'document.documentElement'
        document.documentElement.setAttribute("data-bs-theme", e.matches ? "dark" : "light");
    });

    function toggleTheme() {
        const currentTheme = document.documentElement.getAttribute("data-bs-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";
        applyTheme(newTheme);
    }

    const savedTheme = localStorage.getItem("theme");
    if (savedTheme) {
        applyTheme(savedTheme);
    } else {
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        applyTheme(prefersDark ? "dark" : "light");
    }
</script>