@page "{id:int}"
@model restaurantBudweis.Pages.Clients.DeleteModel
@{
    ViewData["Title"] = "Удалить клиента";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-danger shadow-sm rounded-4">
            <div class="card-header bg-danger text-white rounded-top-4">
                <h5 class="mb-0 text-center">Подтверждение удаления</h5>
            </div>
            <div class="card-body">
                <p class="mb-3 text-center">
                    Вы действительно хотите удалить клиента?
                </p>
                <div class="alert alert-light border rounded-3">
                    <strong>@Model.Client.FullName</strong><br />
                    <small class="text-muted">@Model.Client.PhoneNumber</small>
                </div>
                <form method="post">
                    <input type="hidden" asp-for="Client.Id" />
                    <div class="d-flex justify-content-between gap-2 mt-4">
                        <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4">Отмена</a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4">Удалить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
