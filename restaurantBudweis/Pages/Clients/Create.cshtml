@page
@model restaurantBudweis.Pages.Clients.CreateModel
@{
    ViewData["Title"] = "Добавить клиента";
}
<h1 class="mb-4">Добавить клиента</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Client.FullName" class="form-label">ФИО</label>
                        <input asp-for="Client.FullName" class="form-control" />
                        <span asp-validation-for="Client.FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Client.PhoneNumber" class="form-label">Телефон</label>
                        <input asp-for="Client.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Client.PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Client.TableNumber" class="form-label">Номер столика</label>
                        <input asp-for="Client.TableNumber" class="form-control" />
                        <span asp-validation-for="Client.TableNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Client.VisitDate" class="form-label">Дата посещения</label>
                        <input asp-for="Client.VisitDate" type="date" class="form-control" />
                        <span asp-validation-for="Client.VisitDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Заказанные блюда</label>
                        <select name="SelectedDishIds" class="form-control" multiple size="5" asp-items="Model.AvailableDishes">
                            <option value="">-- Выберите блюда (можно несколько) --</option>
                        </select>
                        <small class="form-text text-muted">Зажмите Ctrl для выбора нескольких блюд</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a asp-page="Index" class="btn btn-secondary">Назад</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}