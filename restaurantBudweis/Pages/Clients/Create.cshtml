@page
@model restaurantBudweis.Pages.Clients.CreateModel
@{
}
<h1 class="mb-4">Добавить клиента</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Clients.FullName" class="form-label">ФИО</label>
                        <input asp-for="Clients.FullName" class="form-control" />
                        <span asp-validation-for="Clients.FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Clients.PhoneNumber" class="form-label">Телефон</label>
                        <input asp-for="Clients.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Clients.PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Clients.TableNumber" class="form-label">Номер столика</label>
                        <input asp-for="Clients.TableNumber" class="form-control" />
                        <span asp-validation-for="Clients.TableNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Clients.VisitDate" class="form-label">Дата посещения</label>
                        <input asp-for="Clients.VisitDate" type="date" class="form-control" />
                        <span asp-validation-for="Clients.VisitDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Clients.Dishs" class="form-label">Блюдо</label>
                        <input asp-for="Clients.Dishs" class="form-control" />
                        <span asp-validation-for="Clients.Dishs" class="text-danger"></span>
                    </div>


                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Сохранить
                        </button>

                        <a asp-page="Index" class="btn btn-secondary">
                            Назад
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
