@page
@model restaurantBudweis.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Список клиентов";
}

<div class="container mt-4">
    <div class="row justify-content-between align-items-center mb-4">
        <div class="col">
            <h1 class="h3 mb-0">Список клиентов</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary rounded-pill px-4">
                + Добавить клиента
            </a>
        </div>
    </div>

    <div class="row">
        @foreach (var client in Model.Clients)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@client.FullName</h5>
                        <p class="card-text text-muted small">
                            <strong>Телефон:</strong> @(string.IsNullOrEmpty(client.PhoneNumber) ? "—" : client.PhoneNumber)<br />
                            <strong>Столик:</strong> @client.TableNumber<br />
                            <strong>Дата:</strong> @client.VisitDate.ToShortDateString()
                        </p>
                        <hr />
                        <div class="mb-2">
                            <strong class="small">Заказанные блюда:</strong><br />
                            @if (client.Dishs != null && client.Dishs.Any())
                            {
                                foreach (var dish in client.Dishs)
                                {
                                    <span class="badge bg-secondary rounded-pill me-1 mb-1">@dish.DishName</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between rounded-bottom-4 bg-body-secondary">
                        <small class="text-muted align-self-center">ID: @client.Id</small>
                        <div class="btn-group gap-2">
                            <a asp-page="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Открыть</a>
                            <a asp-page="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">Изменить</a>
                            <a asp-page="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Clients.Any())
    {
        <div class="alert alert-info text-center rounded-4">
            Список клиентов пуст. Добавьте первого клиента!
        </div>
    }
</div>