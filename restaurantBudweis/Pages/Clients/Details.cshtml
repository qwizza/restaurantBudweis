@page "{id:int}"
@model restaurantBudweis.Pages.Clients.Index1Model
@{
}

<h1>Информация о клиенте</h1>

<div>
    <p><strong>ФИО:</strong> @Model.Client.FullName</p>
    <p><strong>Телефон:</strong> @Model.Client.PhoneNumber</p>
    <p><strong>Номер столика:</strong> @Model.Client.TableNumber</p>
    <p><strong>Блюдо:</strong> @Model.Client.Dishs</p>
    <p><strong>Дата посещения:</strong> @Model.Client.VisitDate.ToShortDateString()</p>
</div>

<p>
    <a asp-page="Index">Назад к списку</a>
</p>
