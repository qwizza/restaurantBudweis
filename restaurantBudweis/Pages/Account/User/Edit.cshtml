@page
@model restaurantBudweis.Pages.Account.User.EditModel
@{
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="h3 card-title mb-4 text-warning">Изменить пользователя</h2>

                    <form method="post">
                        @if (!ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger rounded-3 small"></div>
                        }

                        <input type="hidden" asp-for="AuthUser.Id" />

                        <div class="mb-3">
                            <label asp-for="AuthUser.Email" class="form-label fw-semibold small">Email адрес</label>
                            <input asp-for="AuthUser.Email" class="form-control" />
                            <span asp-validation-for="AuthUser.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AuthUser.Password" class="form-label fw-semibold small">Новый пароль</label>
                            <input asp-for="AuthUser.Password" type="password" class="form-control" />
                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                Оставьте пустым, чтобы не менять текущий пароль
                            </small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AuthUser.Role" class="form-label fw-semibold small">Роль доступа</label>
                            <select asp-for="AuthUser.Role" class="form-select">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning text-white rounded-pill px-4">Сохранить</button>
                            <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>