@page
@model restaurantBudweis.Pages.Account.User.IndexModel
@{
}

<div class="container mt-4">
    <div class="row justify-content-between align-items-center mb-4">
        <div class="col">
            <h1 class="h3 mb-0">Список пользователей</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary rounded-pill px-4">
                + Добавить пользователя
            </a>
        </div>
    </div>

    <div class="row">
        @foreach (var user in Model.Users)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="@(user.AvatarUrl ?? "/avatars/default.png")"
                                 alt="Avatar"
                                 class="rounded-circle border"
                                 style="width: 48px; height: 48px; object-fit: cover;" />
                            <div class="text-truncate">
                                <h5 class="card-title text-primary text-truncate mb-1" title="@user.Email">
                                    @user.Email
                                </h5>
                                <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-secondary")">
                                    @user.Role
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between rounded-bottom-4 bg-body-secondary">
                        <small class="text-muted align-self-center">ID: @user.Id</small>
                        <div class="btn-group gap-2">
                            <a asp-page="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Открыть</a>
                            <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">Изменить</a>
                            <a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

        <script>
            const pageConn = new signalR.HubConnectionBuilder()
                .withUrl("/pageUpdateHub")
                .withAutomaticReconnect()
                .build();

            pageConn.on("RefreshUsers", function () {
                window.location.reload();
            });

            pageConn.start().catch(err => console.error(err.toString()));
        </script>
    }

    @if (!Model.Users.Any())
    {
        <div class="alert alert-info text-center rounded-4">
            Список пользователей пуст.
        </div>
    }
</div>
