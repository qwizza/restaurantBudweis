@page "{id:int}"
@model restaurantBudweis.Pages.Dishs.DetailsModel
@{
    ViewData["Title"] = "Информация о блюде";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Информация о блюде</h4>
                </div>

                <div class="card-body">

                    <h5 class="card-title mb-3">
                        @Model.Dish.DishName
                    </h5>

                    <ul class="list-group list-group-flush mb-3">

                        <li class="list-group-item">
                            <strong>Группа блюд:</strong>
                            <span class="text-muted">@Model.Dish.GroupId</span>
                        </li>

                        <li class="list-group-item">
                            <strong>Цена:</strong>
                            <span class="badge bg-secondary">
                                @Model.Dish.Price
                            </span>
                        </li>

                        <li class="list-group-item">
                            <strong>Время приготовления:</strong>
                            <span class="badge bg-info">
                                @Model.Dish.CookingTimeMinutes
                            </span>
                        </li>

                        <li class="list-group-item">
                            <strong>Описание блюда:</strong>
                            <span class="badge bg-info">
                                @Model.Dish.DescriptionDish
                            </span>
                        </li>

                        <li class="list-group-item">
                            <strong>Ингредиенты:</strong>
                            <span class="badge bg-info">
                                @Model.Dish.Ingredients
                            </span>
                        </li>

                    </ul>

                    <div class="d-flex justify-content-between">

                        <a asp-page="Index" class="btn btn-secondary">
                            Назад
                        </a>

                        <a asp-page="Edit"
                           asp-route-id="@Model.Dish.Id"
                           class="btn btn-warning">
                            Редактировать
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>
