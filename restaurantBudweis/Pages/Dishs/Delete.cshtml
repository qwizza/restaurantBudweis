@page "{id:int}"
@model restaurantBudweis.Pages.Dishs.DeleteModel
@{
    ViewData["Title"] = "Удалить блюдо";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card border-danger shadow-sm">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Удалить блюдо</h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        Вы уверены, что хотите удалить это блюдо?
                    </div>

                    <div class="mb-3">

                        <h5 class="card-title">@Model.Dish.DishName</h5>

                        <p class="card-text text-muted">
                            Группа блюд: @Model.Dish.GroupId
                        </p>

                        <p class="card-text">
                            Цена: <span class="badge bg-info">@Model.Dish.Price</span>
                        </p>

                        <p class="card-text">
                            Описание блюда: <span class="badge bg-info">@Model.Dish.Ingredients</span>
                        </p>

                        <p class="card-text">
                            Ингредиенты: <span class="badge bg-info">@Model.Dish.Ingredients</span>
                        </p>

                        <p class="card-text">
                            Время приготовления: <span class="badge bg-secondary">@Model.Dish.CookingTimeMinutes</span>
                        </p>

                    </div>

                    <form method="post">

                        <input type="hidden" asp-for="Dish.Id" />

                        <div class="d-flex justify-content-between">

                            <a asp-page="Index" class="btn btn-secondary">
                                Отмена
                            </a>

                            <button type="submit" class="btn btn-danger">
                                Удалить
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>