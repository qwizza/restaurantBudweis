@page "{id:int}"
@model restaurantBudweis.Pages.Dishs.EditModel
@{
    ViewData["Title"] = "Редактировать блюдо";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Редактировать блюдо</h4>
                </div>

                <div class="card-body">

                    <form method="post">

                        <input type="hidden" asp-for="Dish.Id" />

                        <div class="mb-3">
                            <label asp-for="Dish.DishName" class="form-label">Название блюда</label>
                            <input asp-for="Dish.DishName" class="form-control" />
                            <span asp-validation-for="Dish.DishName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Dish.GroupDish.Dishs" class="form-label">Автор</label>
                            <input asp-for="Dish.GroupDish.Name" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Dish.Price" class="form-label">Цена</label>
                            <input asp-for="Dish.Price" type="number" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Dish.CookingTimeMinutes" class="form-label">Время приготовления(В минутах)</label>
                            <input asp-for="Dish.CookingTimeMinutes" type="number" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Dish.DescriptionDish" class="form-label">Описание блюда</label>
                            <input asp-for="Dish.DescriptionDish" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Dish.Ingredients" class="form-label">Ингредиенты</label>
                            <input asp-for="Dish.Ingredients" class="form-control" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary">
                                Назад
                            </a>
                            <button type="submit" class="btn btn-warning">
                                Сохранить
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}