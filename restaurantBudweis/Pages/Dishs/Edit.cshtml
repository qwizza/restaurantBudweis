@page "{id:int}"
@model restaurantBudweis.Pages.Dishs.EditModel
@{
    ViewData["Title"] = "Редактировать блюдо";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm rounded-4">
            <div class="card-header bg-warning rounded-top-4">
                <h5 class="mb-0 text-center">Редактирование блюда</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Dish.Id" />

                    <div class="mb-3">
                        <label asp-for="Dish.DishName" class="form-label">Название блюда</label>
                        <input asp-for="Dish.DishName" class="form-control rounded-3" />
                        <span asp-validation-for="Dish.DishName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dish.GroupId" class="form-label">Группа блюд</label>
                        <select asp-for="Dish.GroupId" class="form-control rounded-3" asp-items="Model.GroupDishList">
                            <option value="">-- Выберите группу --</option>
                        </select>
                        <span asp-validation-for="Dish.GroupId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dish.Price" class="form-label">Цена</label>
                        <input asp-for="Dish.Price" type="number" step="0.01" class="form-control rounded-3" />
                        <span asp-validation-for="Dish.Price" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dish.CookingTimeMinutes" class="form-label">Время приготовления (минут)</label>
                        <input asp-for="Dish.CookingTimeMinutes" type="number" class="form-control rounded-3" />
                        <span asp-validation-for="Dish.CookingTimeMinutes" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dish.DescriptionDish" class="form-label">Описание</label>
                        <textarea asp-for="Dish.DescriptionDish" class="form-control rounded-3" rows="3"></textarea>
                        <span asp-validation-for="Dish.DescriptionDish" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dish.Ingredients" class="form-label">Ингредиенты</label>
                        <textarea asp-for="Dish.Ingredients" class="form-control rounded-3" rows="3"></textarea>
                        <span asp-validation-for="Dish.Ingredients" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between gap-2 mt-4">
                        <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4">Назад</a>
                        <button type="submit" class="btn btn-success rounded-pill px-4">Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}